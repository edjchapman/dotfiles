# Path to your oh-my-zsh installation.
export ZSH=~/.oh-my-zsh

# These are read by oh-my-zsh within this shell before it sources, so they only
# need to be shell variables — no export required.
DEFAULT_USER=$USER

ZSH_THEME="agnoster"

# Command auto-correction.
ENABLE_CORRECTION="true"

HIST_STAMPS="yyyy-mm-dd"

# History configuration
HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_SPACE

# Keep manually-typed inline secrets out of the history file. Credentials loaded
# as env vars via ~/.zshrc.local are already safe (never typed inline); this
# guards ad-hoc commands that carry a secret in an assignment or a --flag.
# (Prefix any command with a space to skip history entirely — HIST_IGNORE_SPACE.)
HISTORY_IGNORE='(*(PASSWORD|PASSWD|SECRET|TOKEN|API_KEY|APIKEY|ACCESS_KEY|SECRET_KEY|PRIVATE_KEY|CREDENTIAL)*=*|*--(password|token|api-key|secret|access-key)(=| )*)'

plugins=(
    git
    python
    virtualenv
    pip
    brew
)

# Completion fpath (custom ~/.zfunc + brew) — set BEFORE oh-my-zsh sources so its
# single compinit picks these up; this avoids running a second compinit later.
# HOMEBREW_PREFIX is exported by `brew shellenv` in .zprofile, so the
# $(brew --prefix) fork (~10ms, measured) only pays on shells that skipped
# .zprofile (non-login zsh with a clean environment).
fpath=(~/.zfunc $fpath)
if [[ -n ${HOMEBREW_PREFIX:-} ]]; then
    FPATH=$HOMEBREW_PREFIX/share/zsh-completions:$FPATH
elif type brew &>/dev/null; then
    FPATH=$(brew --prefix)/share/zsh-completions:$FPATH
fi

source $ZSH/oh-my-zsh.sh

# Set CLICOLOR if you want Ansi Colors in iTerm2
export CLICOLOR=1

# PATH — personal scripts ($HOME/bin) take priority; Homebrew (arm64 or Intel) is
# already on PATH via .zprofile (brew shellenv), and ~/.local/bin via pipx there
# too. /usr/local/{s,}bin are kept but placed AFTER $PATH so a stray binary can't
# shadow Homebrew kegs on Apple Silicon.
export PATH="$HOME/bin:$PATH:/usr/local/sbin:/usr/local/bin"

# GNU tools — override BSD defaults with GNU versions
if [[ -d /opt/homebrew/opt/coreutils ]]; then
    for gnubin in coreutils findutils gnu-sed gawk diffutils; do
        [[ -d "/opt/homebrew/opt/$gnubin/libexec/gnubin" ]] && \
            export PATH="/opt/homebrew/opt/$gnubin/libexec/gnubin:$PATH"
    done
fi

# fnm (Fast Node Manager) — auto-switch Node version on cd
if command -v fnm &>/dev/null; then
    eval "$(fnm env --use-on-cd --shell zsh)"
fi

# fzf key bindings and completion
if command -v fzf &>/dev/null; then
    source <(fzf --zsh)
fi

# iTerm2 shell integration (installed on first launch of iTerm2)
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh" || true

# OpenJDK — paths for openjdk@17 (keg-only; only if installed)
# Append to any existing CPPFLAGS (don't clobber).
if [[ -d /opt/homebrew/opt/openjdk@17 ]]; then
    export PATH="/opt/homebrew/opt/openjdk@17/bin:$PATH"
    export CPPFLAGS="-I/opt/homebrew/opt/openjdk@17/include${CPPFLAGS:+ $CPPFLAGS}"
fi

# Machine-specific secrets and credentials (AWS, GitHub, Jira, etc.)
# Managed by chezmoi (encrypted_private_dot_zshrc.local.age)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Windsurf (only if installed)
[[ -d "$HOME/.codeium/windsurf/bin" ]] && export PATH="$HOME/.codeium/windsurf/bin:$PATH"

# CLAUDE
export DISABLE_AUTOUPDATER=1
export ENABLE_TOOL_SEARCH=auto:5

# Suppress Homebrew informational hints while keeping automatic updates enabled
export HOMEBREW_NO_ENV_HINTS=1

# brew cleanup only prunes cached downloads older than this (default: 120).
# brewup() runs cleanup daily, so 30 keeps the cask-installer cache bounded
# without a separate command — it had reached 15GB of DMGs for apps already
# installed, none of which brew would touch under the default threshold.
export HOMEBREW_CLEANUP_MAX_AGE_DAYS=30

# Homebrew maintenance paths. Defined ahead of brewup() so the function can own
# its own failure-marker bookkeeping.
#
# The values live in ~/.local/lib/brewup-paths.sh rather than here: chezmoi-fix
# and chezmoi-drift-check both read the failure marker, and neither can source
# a zsh startup file. Editing a path there moves it for the writer and both
# readers at once — editing it in one place alone used to stop the signal
# flowing with no error anywhere.
#
# Sourcing is optional: this runs on every shell start, and a fresh or
# partially-applied $HOME has no such file yet. The defaults below mirror it
# exactly, so that case keeps working instead of breaking the shell.
# shellcheck disable=SC1090
[[ -r "$HOME/.local/lib/brewup-paths.sh" ]] && source "$HOME/.local/lib/brewup-paths.sh"
: "${BREWUP_STAMP:=$HOME/.cache/brewup.last}"
: "${BREWUP_FAIL:=$HOME/.cache/brewup.failed}"
: "${BREWUP_LOG:=$HOME/.cache/brewup.log}"
: "${BREWUP_LOCK:=$HOME/.cache/brewup.lock}"
mkdir -p "$HOME/.cache"

# Homebrew daily maintenance: upgrade, sanity-check, cleanup.
# Returns non-zero when the upgrade failed, but still runs doctor and cleanup:
# an early `return 1` here let one wedged package (a cask whose staging dir was
# left occupied by an interrupted upgrade) silently disable doctor and cleanup
# for days, so stale downloads accumulated while nothing reported a problem.
#
# Owns the failure marker that chezmoi-drift-check reads. It lives here rather
# than in the daily runner below because "did brewup succeed" is a property of
# this function, not of whichever scheduler called it. While the runner owned
# it, a manual `brewup` could neither clear a stale marker nor record a fresh
# failure — so a successful manual run left the banner reporting a failure that
# had already been fixed.
brewup() {
  emulate -L zsh
  setopt pipefail
  local rc=0
  # Default mirrors ~/.local/lib/brewup-paths.sh so the function stays correct
  # if it is ever called before/without the block above (e.g. sourced in
  # isolation, which is how the bats suite drives it).
  local marker="${BREWUP_FAIL:-$HOME/.cache/brewup.failed}"

  print -P "\n%F{cyan}==> brew upgrade%f"
  if ! command brew upgrade; then
    print -P "%F{red}brew upgrade failed%f"
    rc=1
  fi

  print -P "\n%F{cyan}==> brew doctor%f"
  if ! command brew doctor; then
    print -P "%F{yellow}brew doctor reported issues (non-fatal)%f"
  fi

  print -P "\n%F{cyan}==> brew cleanup%f"
  command brew cleanup

  if (( rc == 0 )); then
    rm -f "$marker"
    print -P "\n%F{green}Done.%f\n"
  else
    date '+%Y-%m-%d %H:%M:%S' >| "$marker"
    print -P "\n%F{red}Done, with a failed upgrade — see 'brewlog'.%f\n"
  fi
  return $rc
}

# Auto-run brewup once per day on first shell. Output is appended to
# ~/.cache/brewup.log (last ~2000 lines kept); `brewlog` tails it.
# A directory-based lock prevents concurrent runs when multiple shells
# open in quick succession. Stale locks (>1h) are cleared on next entry.
# Paths are defined above, next to brewup() itself.

if [[ -d "$BREWUP_LOCK" ]]; then
  # Use the absolute BSD stat: Homebrew coreutils may shadow it on PATH with
  # GNU stat, whose `-f` means "filesystem mode" and prints a path string that
  # breaks the arithmetic below ("bad math expression").
  _brewup_lock_mtime=$(/usr/bin/stat -f %m "$BREWUP_LOCK" 2>/dev/null || echo 0)
  (( $(date +%s) - _brewup_lock_mtime > 3600 )) && rmdir "$BREWUP_LOCK" 2>/dev/null
  unset _brewup_lock_mtime
fi

if [[ ! -f "$BREWUP_STAMP" || "$(date +%F)" != "$(cat "$BREWUP_STAMP" 2>/dev/null)" ]]; then
  (
    if mkdir "$BREWUP_LOCK" 2>/dev/null; then
      trap 'rmdir "$BREWUP_LOCK" 2>/dev/null' EXIT INT TERM HUP
      {
        echo "=== brewup $(date '+%Y-%m-%d %H:%M:%S') ==="
        # brewup() owns the failure marker; this runner owns only the daily
        # stamp. Stamp regardless of outcome: the guard means "attempted
        # today", not "succeeded today". Stamping only on success turned a
        # persistently failing upgrade into one brewup per new shell — 50 runs
        # in a day, each re-mounting a cached 276MB DMG, with doctor/cleanup
        # never reached. A wedged package now costs one run per day.
        brewup
        date +%F >| "$BREWUP_STAMP"
      } >>"$BREWUP_LOG" 2>&1
      tail -n 2000 "$BREWUP_LOG" >"$BREWUP_LOG.tmp" 2>/dev/null && mv "$BREWUP_LOG.tmp" "$BREWUP_LOG"
    fi
  ) &!
fi

# Short aliases for the management surface (see CLAUDE.md / README).
alias mac='chezmoi-fix'
alias brewlog='tail -F ~/.cache/brewup.log'

# chezmoi drift banner — one composed line covering every signal on shell
# start: home files, brew missing/extra, macOS defaults, security baseline,
# and pending brew-inbox events. e.g.
#   chezmoi: home 2 · brew-extra 5 · inbox 3 — run 'mac' (as of 2h ago)
# The drift segments are composed by chezmoi-drift-check and read verbatim out
# of $banner; only the live parts (inbox count, cache age, colour) are built
# here. Cached state is read synchronously by sourcing the file — never by
# invoking chezmoi-drift-check, which would put a fork on the startup path of
# every shell and tmux pane. A TTL-bounded refresh is kicked off in the
# background instead — it only re-runs the full check when the cache is older
# than $CHEZMOI_DRIFT_TTL (default 4h), otherwise it's a no-op.
# CHEZMOI_DRIFT_QUIET=1 skips this whole block — the banner AND its
# TTL-gated background refresh. The cache still refreshes elsewhere (the
# daily launchd run, and the brew/mas/chezmoi wrappers below), and the daily
# launchd notification still fires.
if [[ -z "${CHEZMOI_DRIFT_QUIET:-}" ]] && command -v chezmoi-drift-check &>/dev/null; then
  _drift_state="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-drift/state"
  _cache_age=-1
  _age_suffix=
  _parts=
  if [[ -f "$_drift_state" ]]; then
    # Cleared before sourcing so a shell variable of the same name cannot be
    # mistaken for a field the state file actually carries. $banner is legally
    # empty (clean machine), so only a set-vs-unset test can tell "this cache
    # predates the field" from "this cache says there is nothing to report".
    unset banner drift_total
    # shellcheck disable=SC1090
    source "$_drift_state" 2>/dev/null
    # Cache age — used both to gate the background refresh below (avoid one
    # fork per new shell/tmux pane when state is still fresh) and to annotate
    # the banner when the snapshot is materially stale.
    if [[ "${CHECKED_AT:-0}" =~ ^[0-9]+$ ]] && (( CHECKED_AT > 0 )); then
      _cache_age=$(( $(date +%s) - CHECKED_AT ))
      if (( _cache_age >= 3600 )); then
        _age_suffix=" (as of $(( _cache_age / 3600 ))h ago)"
      fi
    fi
    if [[ -n "${banner+x}" ]]; then
      # chezmoi-drift-check composes the drift segments, so the banner and
      # `mac` cannot disagree about what is pending. Everything below this
      # point — inbox, age, colour, the run-'mac' tail — is read-time and
      # stays here.
      _parts="$banner"
    else
      # Fallback: a state file written before chezmoi-drift-check composed the
      # banner. The cache TTL is 4h, so one exists in the wild after every
      # upgrade; without this the first shells afterwards would show nothing.
      # Removable once no such cache can survive — this must render identically
      # to what the writer now produces.
      (( ${HOME_DRIFT:-0} > 0 ))     && _parts+="${_parts:+ · }home ${HOME_DRIFT}"
      (( ${BREW_MISSING:-0} > 0 ))   && _parts+="${_parts:+ · }brew-missing ${BREW_MISSING}"
      (( ${BREW_EXTRA:-0} > 0 ))     && _parts+="${_parts:+ · }brew-extra ${BREW_EXTRA}"
      (( ${DEFAULTS_DRIFT:-0} > 0 )) && _parts+="${_parts:+ · }defaults ${DEFAULTS_DRIFT}"
      (( ${SECURITY_DRIFT:-0} > 0 )) && _parts+="${_parts:+ · }security ${SECURITY_DRIFT}"
      # Daily brewup failed and has stayed failed. Its own segment rather than a
      # count: this is a maintenance outage, not $HOME drift, and the fix is to
      # read the log rather than to apply or re-add anything.
      [[ "${BREWUP_FAILED:-0}" == "1" ]] && _parts+="${_parts:+ · }brewup-failed"
      # A check error is surfaced as its own segment so it is never masked by
      # (or mistaken for) real drift counts.
      [[ "${HAD_ERROR:-0}" == "1" ]] && _parts+="${_parts:+ · }check-error"
    fi
    unset HOME_DRIFT BREW_MISSING BREW_EXTRA BREW_EXTRA_NAMES DEFAULTS_DRIFT SECURITY_DRIFT BREWUP_FAILED HAD_ERROR CHECKED_AT summary banner drift_total
  fi
  unset _drift_state

  # Pending brew-inbox events join the same line as an 'inbox N' segment.
  # The count flips the whole banner red at >= 10 so users notice before the
  # journal merge becomes a chore.
  _inbox="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-brew-inbox/journal.ndjson"
  _inbox_n=0
  [[ -s $_inbox ]] && _inbox_n=$(wc -l <"$_inbox" | tr -d ' ')
  (( _inbox_n > 0 )) && _parts+="${_parts:+ · }inbox ${_inbox_n}"
  unset _inbox

  if [[ -n $_parts ]]; then
    _color=yellow
    (( _inbox_n >= 10 )) && _color=red
    print -P "%F{$_color}chezmoi: ${_parts} — run 'mac'${_age_suffix}%f"
    unset _color
  else
    # Quiet shortcuts tip when nothing fired. Dim grey (%F{8}) so it never
    # dominates the prompt.
    print -P "%F{8}tip: 'mac' for chezmoi state · 'brewlog' for today's brew output%f"
  fi
  unset _parts _inbox_n _age_suffix

  # Background refresh — only spawn when the cache is missing or older than
  # CHEZMOI_DRIFT_TTL (default 4h). The script itself would no-op inside the
  # TTL window, but skipping the fork keeps a fresh tmux session from
  # spawning N chezmoi-drift-check processes for no work.
  if (( _cache_age < 0 || _cache_age >= ${CHEZMOI_DRIFT_TTL:-14400} )); then
    (chezmoi-drift-check --brief --quiet) &>/dev/null &!
  fi
  unset _cache_age
fi

# brew/mas wrappers — record each mutating invocation to the inbox journal and
# kick off an async drift refresh. The recorder is silent on failure so it can
# never break a working brew/mas command.
brew() {
  command brew "$@"
  local rc=$? subcmd="${1:-}"
  case "$subcmd" in
    install|uninstall|reinstall|tap|untap)
      command -v chezmoi-brew-record &>/dev/null && \
        chezmoi-brew-record --rc "$rc" -- "$@" &>/dev/null &!
      command -v chezmoi-drift-check &>/dev/null && \
        (chezmoi-drift-check --full --quiet) &>/dev/null &!
      ;;
  esac
  return $rc
}

mas() {
  command mas "$@"
  local rc=$? subcmd="${1:-}"
  case "$subcmd" in
    install|uninstall|purchase)
      command -v chezmoi-brew-record &>/dev/null && \
        chezmoi-brew-record --rc "$rc" --tool mas -- "$@" &>/dev/null &!
      command -v chezmoi-drift-check &>/dev/null && \
        (chezmoi-drift-check --full --quiet) &>/dev/null &!
      ;;
  esac
  return $rc
}

# chezmoi apply wrapper — kick off an async drift refresh after each apply so
# the banner reflects post-apply state rather than the stale pre-apply cache
# (which otherwise lingers until the TTL window expires, default 4h).
chezmoi() {
  command chezmoi "$@"
  local rc=$? subcmd="${1:-}"
  case "$subcmd" in
    apply)
      command -v chezmoi-drift-check &>/dev/null && \
        (chezmoi-drift-check --full --quiet) &>/dev/null &!
      ;;
  esac
  return $rc
}

# NotebookLM Drive sync destination — used by career-portfolio's
# `make sync-notebooklm-drive` (safe sources 01-05 by default). Non-secret
# Google Drive folder path. Uses a dedicated read-write rclone remote
# `gdrive-rw` (the general `gdrive` remote is drive.readonly). Configure once:
#   rclone config create gdrive-rw drive scope drive
export NOTEBOOKLM_RCLONE_REMOTE="gdrive-rw:career-portfolio"
