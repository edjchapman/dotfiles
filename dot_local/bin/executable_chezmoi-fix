#!/usr/bin/env bash
# chezmoi-fix — single interactive entry point for remediating detected drift.
#
# Refreshes the drift cache, summarises what's pending across the three signals
# (home-file drift, brew-bundle drift, brew-inbox journal), and dispatches to the
# appropriate tool. Stateless: each option is one tool away.
#
# Designed to be the target of the shell banner. Banner says "drift detected →
# run chezmoi-fix"; user types `chezmoi-fix` and walks a numbered menu.

set -uo pipefail

die() {
    echo "chezmoi-fix: $*" >&2
    exit 1
}

# plural <n> <singular> [<plural>] — defaults plural form to <singular>+s.
plural() {
    local n=$1 s=$2 p=${3:-${2}s}
    if ((n == 1)); then printf '%s' "$s"; else printf '%s' "$p"; fi
}

# A Homebrew tap is "org/name" (one slash); a tapped formula is "org/name/formula"
# (two) and core formulae/casks have none. Taps are removed with `untap`, not
# `uninstall` (which would look for a formula named after the tap and fail).
is_brew_tap() { [[ $1 == */* && $1 != */*/* ]]; }

# Kick off a background refresh of the drift cache. Every mutating menu path
# must end in one of these: the cache was refreshed *before* remediation, so
# without it the banner keeps reporting the drift the user just fixed for up
# to $CHEZMOI_DRIFT_TTL (4h). The dot_zshrc chezmoi() wrapper can't cover
# this — it only fires when `chezmoi` is typed interactively, not when this
# script invokes the real binary.
refresh_drift() {
    command -v chezmoi-drift-check >/dev/null 2>&1 \
        && (chezmoi-drift-check --full --quiet >/dev/null 2>&1 &)
    return 0
}

# Run a remediation command, refresh the cache, exit with the command's rc.
# Replaces the bare `exec` for mutating dispatch targets; read-only targets
# (doctor, --drift inspections) keep exec — nothing to refresh.
run_then_refresh() {
    "$@"
    local rc=$?
    refresh_drift
    exit "$rc"
}

# Reported rather than offered as a menu action: the failure modes (a wedged
# cask staging dir, a tap fetch error, a full disk) have no safe generic
# remedy, so the useful move is to show the tail and let the user decide.
brewup_failed_notice() {
    local marker="${BREWUP_FAIL:-$HOME/.cache/brewup.failed}"
    local when=
    [[ -f $marker ]] && when=$(<"$marker")
    echo "   brewup: last daily run FAILED${when:+ (${when})}"
    echo "   hint: 'brewlog' tails ~/.cache/brewup.log; the upgrade error is"
    echo "   under the most recent '=== brewup' header. Re-run with 'brewup'."
}

# Test hook: `chezmoi-fix --is-tap <name>` exits 0 if <name> is a bare tap, 1
# otherwise — lets bats-core verify tap detection without the interactive flow.
if [[ ${1:-} == --is-tap ]]; then
    is_brew_tap "${2:-}"
    exit $?
fi

# Test hook: when set, skip the runtime prerequisites (chezmoi, TTY, drift-check
# refresh) and exit after rendering the menu. Lets bats-core exercise menu
# logic against synthetic state files without a real chezmoi install.
TEST_MODE=${CHEZMOI_FIX_TEST_MODE:-0}

if ((TEST_MODE == 0)); then
    command -v chezmoi >/dev/null 2>&1 || die "chezmoi not installed"
fi

TTY=/dev/tty
if ((TEST_MODE == 0)); then
    [[ -r $TTY && -w $TTY ]] || die "no tty available; chezmoi-fix is interactive"
fi

# The brewup failure marker brewup_failed_notice reports on. Shared with the
# zsh writer and chezmoi-drift-check so a path edit reaches all three; optional
# and failure-tolerated, with a fallback matching the shared file's own default,
# so a fresh or partially-applied $HOME still behaves as it does today.
# Deliberately $HOME/.cache and not $XDG_CACHE_HOME, unlike the two paths below
# — see the comment in the shared file for why.
# shellcheck disable=SC1090,SC1091
[[ -r "$HOME/.local/lib/brewup-paths.sh" ]] && . "$HOME/.local/lib/brewup-paths.sh"

DRIFT_STATE="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-drift/state"
INBOX_JOURNAL="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-brew-inbox/journal.ndjson"

# Read the cached counts that the banner saw before we refresh and overwrite
# them. We use this to detect when something resolved between the banner and
# the menu — without this the user sees "banner said 2, menu shows 1" with no
# explanation. Inbox isn't part of the banner's drift total (it has its own
# banner line) so we exclude it from the comparison below.
cached_drift_total=0
if [[ -f $DRIFT_STATE ]]; then
    HOME_DRIFT=0
    BREW_MISSING=0
    BREW_EXTRA=0
    DEFAULTS_DRIFT=0
    SECURITY_DRIFT=0
    drift_total=
    # shellcheck disable=SC1090
    source "$DRIFT_STATE" 2>/dev/null || true
    # chezmoi-drift-check owns the drift schema and composes the total, so read
    # it rather than re-summing the counts here. A cache written before that
    # field existed (TTL is 4h) has none, so fall back to the sum.
    if [[ $drift_total =~ ^[0-9]+$ ]]; then
        cached_drift_total=$drift_total
    else
        cached_drift_total=$((${HOME_DRIFT:-0} + ${BREW_MISSING:-0} + ${BREW_EXTRA:-0} + ${DEFAULTS_DRIFT:-0} + ${SECURITY_DRIFT:-0}))
    fi
fi

# Refresh drift counts up-front (quiet — we render our own summary). If the
# refresh fails (e.g. broken Brewfile.tmpl), fall through to whatever cached
# state is on disk; the menu will still surface the brew-inbox option.
if ((TEST_MODE == 0)); then
    echo "==> Refreshing drift signals…"
    if command -v chezmoi-drift-check >/dev/null 2>&1; then
        chezmoi-drift-check --full --quiet >/dev/null 2>&1 || true
    fi
fi

HOME_DRIFT=0
BREW_MISSING=0
BREW_EXTRA=0
BREW_EXTRA_NAMES=
DEFAULTS_DRIFT=0
SECURITY_DRIFT=0
BREWUP_FAILED=0
HAD_ERROR=0
summary=
drift_total=
if [[ -f $DRIFT_STATE ]]; then
    # shellcheck disable=SC1090
    source "$DRIFT_STATE" 2>/dev/null || true
fi
if [[ $drift_total =~ ^[0-9]+$ ]]; then
    fresh_drift_total=$drift_total
else
    fresh_drift_total=$((${HOME_DRIFT:-0} + ${BREW_MISSING:-0} + ${BREW_EXTRA:-0} + ${DEFAULTS_DRIFT:-0} + ${SECURITY_DRIFT:-0}))
fi

inbox_count=0
[[ -s $INBOX_JOURNAL ]] && inbox_count=$(wc -l <"$INBOX_JOURNAL" | tr -d ' ')

# Inbox is not drift — it has its own banner segment and its own menu entry —
# but it is actionable, so it joins the total that decides whether there is
# anything to show at all.
total=$((fresh_drift_total + inbox_count))

echo
echo "==> chezmoi-fix"
if ((${HAD_ERROR:-0} > 0)); then
    echo "   ${summary:-drift check encountered an error}"
    echo "   hint: 'make verify-templates' checks template rendering (e.g. a broken"
    echo "   Brewfile.tmpl kills the brew counts); 'chezmoi doctor' checks the env."
elif ((total == 0)); then
    echo "   No drift detected. ${summary:-drift: clean}"
    # A failed brewup is not drift and contributes nothing to $total, so it must
    # be reported before the clean-state early exit — otherwise the one command
    # the banner tells you to run would answer "nothing to fix" while daily
    # maintenance stays broken. Fall through to the menu rather than exiting, so
    # the audit entries stay reachable while brewup is broken.
    if ((${BREWUP_FAILED:-0} > 0)); then
        brewup_failed_notice
    else
        echo "   Nothing to fix."
        exit 0
    fi
else
    echo "   ${summary:-drift detected}"
    ((${BREWUP_FAILED:-0} > 0)) && brewup_failed_notice
    ((inbox_count > 0)) && echo "   brew inbox: ${inbox_count} $(plural "$inbox_count" event) pending"
    if ((cached_drift_total > 0 && cached_drift_total != fresh_drift_total)); then
        echo "   (refreshed: banner showed ${cached_drift_total}, now ${fresh_drift_total})"
    fi
fi
echo

# Build menu entries. Each entry is three pipe-separated fields:
#   <id>|<description>|<command>
# Options appear only when their preconditions are met, so the menu never
# offers a no-op. When something is actionable (drift, inbox events, or a
# drift-check error), the "audit a clean baseline" entries are suppressed —
# they belong to a reconnaissance surface, not a remediation one.
OPTS=()
has_action=$((fresh_drift_total + inbox_count + ${HAD_ERROR:-0}))

((inbox_count > 0)) \
    && OPTS+=("brew-sync|Merge ${inbox_count} brew $(plural "$inbox_count" event) into Brewfile.tmpl|chezmoi-brew-sync")

if ((${HOME_DRIFT:-0} > 0 || ${BREW_MISSING:-0} > 0)); then
    apply_desc="Review diff & apply"
    ((${HOME_DRIFT:-0} > 0)) \
        && apply_desc+=" ${HOME_DRIFT} home-file $(plural "$HOME_DRIFT" change)"
    if ((${BREW_MISSING:-0} > 0)); then
        ((${HOME_DRIFT:-0} > 0)) && apply_desc+=" +"
        apply_desc+=" ${BREW_MISSING} missing brew $(plural "$BREW_MISSING" package)"
    fi
    OPTS+=("apply|${apply_desc}|chezmoi diff, confirm, chezmoi apply")
fi

((${HOME_DRIFT:-0} > 0)) \
    && OPTS+=("backup|Back up locally-edited files into the repo|chezmoi re-add, guided per file")

((${BREW_EXTRA:-0} > 0)) \
    && OPTS+=("brew-extra|Resolve ${BREW_EXTRA} brew-extra $(plural "$BREW_EXTRA" package)|adopt into Brewfile / uninstall, per package")

if command -v chezmoi-defaults-audit >/dev/null 2>&1; then
    if ((${DEFAULTS_DRIFT:-0} > 0)); then
        OPTS+=("defaults|Inspect ${DEFAULTS_DRIFT} macOS defaults drift|chezmoi-defaults-audit --drift")
        OPTS+=("defaults-apply|Re-assert macOS defaults|chezmoi-defaults-audit --apply")
    elif ((has_action == 0)); then
        OPTS+=("defaults|Audit macOS defaults (no known drift)|chezmoi-defaults-audit")
    fi
fi
if command -v chezmoi-security-audit >/dev/null 2>&1; then
    if ((${SECURITY_DRIFT:-0} > 0)); then
        OPTS+=("security|Inspect ${SECURITY_DRIFT} security baseline $(plural "$SECURITY_DRIFT" failure)|chezmoi-security-audit --drift")
    elif ((has_action == 0)); then
        OPTS+=("security|Security baseline check (no known drift)|chezmoi-security-audit")
    fi
fi

# Always available.
OPTS+=("doctor|Run chezmoi doctor (health diagnostic)|chezmoi doctor")
OPTS+=("dismiss|Silence drift banner for this shell session|export CHEZMOI_DRIFT_QUIET=1")

# Compute description column width once so the arrow column is self-aligning
# regardless of which options appear or what counts each label embeds.
desc_width=0
for entry in "${OPTS[@]}"; do
    IFS='|' read -r _ desc _ <<<"$entry"
    ((${#desc} > desc_width)) && desc_width=${#desc}
done

echo "What would you like to do?"
for i in "${!OPTS[@]}"; do
    IFS='|' read -r _ desc cmd <<<"${OPTS[i]}"
    printf "  %d) %-*s  →  %s\n" $((i + 1)) "$desc_width" "$desc" "$cmd"
done
echo "  q) Quit"
echo

((TEST_MODE > 0)) && exit 0

read -r -p "Choice [q]: " reply <"$TTY"
reply=${reply:-q}

[[ $reply == q || $reply == Q ]] && exit 0

if ! [[ $reply =~ ^[0-9]+$ ]] || ((reply < 1 || reply > ${#OPTS[@]})); then
    die "invalid choice"
fi

id=${OPTS[$((reply - 1))]%%|*}

case "$id" in
    brew-sync) run_then_refresh chezmoi-brew-sync ;;
    apply)
        echo
        echo "==> chezmoi diff (review carefully before applying):"
        chezmoi diff
        echo
        read -r -p "Run chezmoi apply now? [y/N] " confirm <"$TTY"
        if [[ $confirm =~ ^[Yy]$ ]]; then
            run_then_refresh chezmoi apply
        fi
        echo "apply skipped — re-run chezmoi-fix when ready"
        ;;
    brew-extra)
        read -r -a extras <<<"${BREW_EXTRA_NAMES:-}"
        if ((${#extras[@]} == 0)); then
            # Names unavailable (older cache schema) — surface the manual recipe.
            rendered=$(mktemp -t brewfile-rendered.XXXXXX)
            trap 'rm -f "$rendered"' EXIT
            chezmoi execute-template <"$(chezmoi source-path)/Brewfile.tmpl" >"$rendered" 2>/dev/null
            echo
            echo "==> brew bundle cleanup --dry-run (packages not in Brewfile.tmpl):"
            brew bundle cleanup --file="$rendered" || true
            echo
            echo "If you want to keep these — install them through Homebrew first, then run"
            echo "chezmoi-brew-sync to record them in Brewfile.tmpl. If you want to remove"
            echo "them, run: brew bundle cleanup --file=$rendered --force"
            exit 0
        fi
        adopted=0
        removed=0
        for pkg in "${extras[@]}"; do
            echo
            read -r -p "${pkg} — [a]dopt into Brewfile / [u]ninstall / [s]kip? [s] " action <"$TTY"
            case "$action" in
                a | A)
                    # Synthesize a journal event; chezmoi-brew-record resolves
                    # cask vs formula itself, and chezmoi-brew-sync brings its
                    # section routing, validation, and diff/confirm machinery.
                    if chezmoi-brew-record --rc 0 --tool brew -- install "$pkg"; then
                        adopted=$((adopted + 1))
                        echo "   queued for Brewfile merge: $pkg"
                    else
                        echo "   could not record $pkg" >&2
                    fi
                    ;;
                u | U)
                    read -r -p "   really remove ${pkg}? [y/N] " confirm <"$TTY"
                    if [[ $confirm =~ ^[Yy]$ ]]; then
                        # Not in Brewfile.tmpl, so there's no journal event to record.
                        # A bare "org/tap" is a tap → untap; anything else → uninstall.
                        if is_brew_tap "$pkg"; then
                            if brew untap "$pkg"; then
                                removed=$((removed + 1))
                            else
                                echo "   untap failed: $pkg" >&2
                            fi
                        elif brew uninstall "$pkg"; then
                            removed=$((removed + 1))
                        else
                            echo "   uninstall failed: $pkg" >&2
                        fi
                    else
                        echo "   kept $pkg (still unmanaged)"
                    fi
                    ;;
                *) echo "   skipped $pkg" ;;
            esac
        done
        if ((adopted > 0)); then
            echo
            read -r -p "Merge ${adopted} adopted $(plural "$adopted" package) into Brewfile.tmpl now? [Y/n] " go <"$TTY"
            [[ $go =~ ^[Nn]$ ]] || run_then_refresh chezmoi-brew-sync
        fi
        # Uninstalls (and adopts whose merge was declined) changed what the
        # BREW_EXTRA count would find; skipping everything changed nothing.
        if ((removed > 0 || adopted > 0)); then refresh_drift; fi
        ;;
    backup)
        # Walk each drifted file: show its diff, then choose a direction —
        # apply (repo wins), re-add (local edit wins), or skip. Templates and
        # encrypted sources need special routing: re-add would flatten a
        # rendered template into a literal file, and secrets must round-trip
        # through age encryption rather than plain re-add.
        src_dir=$(chezmoi source-path)
        status_re='^[ ADMR][ ADMR] '
        backed_up=()
        changed=0
        while IFS= read -r line; do
            [[ $line =~ $status_re ]] || continue
            rel=${line:3}
            target="$HOME/$rel"
            src=$(chezmoi source-path -- "$target" 2>/dev/null || true)
            echo
            echo "==> $rel"
            chezmoi diff -- "$target" || true
            if [[ ${src:-} == *.tmpl ]]; then
                echo "   source is a template — 'chezmoi re-add' would flatten it."
                echo "   To keep the local edit, fold it into: $src"
                continue
            fi
            read -r -p "   [a]pply repo version / [b]ack up my version / [s]kip? [s] " action <"$TTY"
            case "$action" in
                a | A)
                    if chezmoi apply -- "$target"; then
                        echo "   applied repo version"
                        changed=1
                    fi
                    ;;
                b | B)
                    if [[ $(basename "${src:-unknown}") == encrypted_* ]]; then
                        chezmoi add --encrypt -- "$target" && backed_up+=("$rel")
                    else
                        chezmoi re-add -- "$target" && backed_up+=("$rel")
                    fi
                    ;;
                *) echo "   skipped" ;;
            esac
        done < <(chezmoi status --exclude=externals 2>/dev/null)
        if ((changed || ${#backed_up[@]} > 0)); then refresh_drift; fi
        if ((${#backed_up[@]} > 0)); then
            echo
            echo "Backed up ${#backed_up[@]} $(plural "${#backed_up[@]}" file) into the source repo."
            echo "main is PR-protected — publish with:"
            echo "   cd $src_dir"
            echo "   git checkout -b backup/local-edits"
            echo "   git add -A && git commit"
            echo "   git push -u origin backup/local-edits && gh pr create --fill"
        fi
        ;;
    defaults) exec chezmoi-defaults-audit --drift ;;
    defaults-apply) run_then_refresh chezmoi-defaults-audit --apply ;;
    security) exec chezmoi-security-audit --drift ;;
    doctor) exec chezmoi doctor ;;
    dismiss)
        echo
        echo "Run this in your current shell:"
        echo "  export CHEZMOI_DRIFT_QUIET=1"
        echo
        echo "(The daily 09:30 launchd notification still fires. Unset on next login.)"
        ;;
esac
