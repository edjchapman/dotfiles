#!/usr/bin/env bash
# chezmoi-drift-check — detect drift between $HOME and chezmoi source state.
# Read-only w.r.t. $HOME. Cached. Safe to call from shell startup, launchd, or interactively.
#
# Drift sources covered:
#   - $HOME files chezmoi manages (via `chezmoi status --exclude=externals`)
#   - Brewfile.tmpl: missing entries (`brew bundle check`),
#     extras (`brew bundle cleanup` dry-run)
#   - Daily `brewup` outcome (marker file written by brewup() in dot_zshrc).
#     Not drift as such, but a maintenance outage that is otherwise invisible
#     unless someone reads ~/.cache/brewup.log by hand.
#
# State file (sourced by the dot_zshrc banner block) is written atomically via
# tmp+mv so concurrent writers (launchd, brew wrapper, shell startup refresh)
# never leave a partially-written file for the synchronous reader.
#
# Schema — UPPERCASE fields are raw counted signals, lowercase fields are
# values this script derives from them. Full breakdown, including what to do
# about each, is in docs/runbooks/recover-from-drift.md.
#   HOME_DRIFT BREW_MISSING BREW_EXTRA DEFAULTS_DRIFT SECURITY_DRIFT  counts
#   BREW_EXTRA_NAMES BREWUP_FAILED HAD_ERROR CHECKED_AT               signals
#   summary       notification/CLI line ("drift: home: 2, brew-extra: 5")
#   banner        prompt-banner segments ("home 2 · brew-extra 5"); may be empty
#   drift_total   sum of the five counts
# Readers must treat `banner` and `drift_total` as optional: a cache written
# before they existed can survive for up to $TTL.

set -uo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-drift"
STATE_FILE="$CACHE_DIR/state"
# Written by brewup() in dot_zshrc: present => the last run failed. The path
# comes from the definitions file that same writer sources, so moving it there
# moves it for writer and readers together.
#
# Optional, and failure tolerated — the same shape as the state file sourced
# further down. This script runs from shell startup, so a fresh or
# partially-applied $HOME must degrade rather than fail; the fallback below
# mirrors the shared file's own default.
#
# Deliberately $HOME/.cache and not $XDG_CACHE_HOME: the writer hardcodes that
# path for every brewup file (stamp/log/lock), so honouring XDG here would read
# a path nothing ever writes the moment XDG_CACHE_HOME is set.
# shellcheck disable=SC1090,SC1091
[[ -r "$HOME/.local/lib/brewup-paths.sh" ]] && . "$HOME/.local/lib/brewup-paths.sh"
BREWUP_FAIL_MARKER="${BREWUP_FAIL:-$HOME/.cache/brewup.failed}"
TTL="${CHEZMOI_DRIFT_TTL:-14400}"
MODE=brief
NOTIFY=0
ALERT=0
QUIET=0

usage() {
    cat <<'EOF'
chezmoi-drift-check [--brief|--full] [--notify|--alert] [--quiet]

  --brief   (default) Use cached state if newer than $CHEZMOI_DRIFT_TTL (default 4h);
            otherwise re-run all checks.
  --full    Always re-run all checks, ignoring the cache.
  --notify  Post a macOS Notification Center alert if drift is detected (fire-and-forget).
  --alert   Post a clickable AppleScript dialog with a "Fix now" button that launches
            chezmoi-fix in iTerm. Auto-dismisses after 90 seconds. Implies --notify is not used.
  --quiet   Suppress stdout; exit code only.

  --parse-cleanup   Test hook: read `brew bundle cleanup` dry-run output on stdin,
                    print "<count>\t<space-joined names>" and exit. No checks run.

Exit codes: 0 clean, 1 drift, 2 error (a check could not be run).
State cache: $XDG_CACHE_HOME/chezmoi-drift/state (or ~/.cache/...).
EOF
}

for arg in "$@"; do
    case "$arg" in
        --brief) MODE=brief ;;
        --full) MODE=full ;;
        --parse-cleanup) MODE=parse-cleanup ;;
        --notify) NOTIFY=1 ;;
        --alert) ALERT=1 ;;
        --quiet) QUIET=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "chezmoi-drift-check: unknown arg: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

emit() { [[ $QUIET -eq 0 ]] && printf '%s\n' "$*"; }

# Parse `brew bundle cleanup` dry-run output into one package/tap name per line.
# Modern brew prints block form — a `Would uninstall formulae:` / `... casks:` /
# `Would untap:` header followed by one bare name per line — while older brew
# printed inline form (`Would uninstall foo`). Cache cleanups
# (`Would remove: /path/…`) and empty-directory sweeps
# (`Would remove (empty directory): /path`) are not packages and are skipped
# in both forms.
parse_cleanup_names() {
    awk '
        /^Would (uninstall|remove|untap).*:$/ { collecting = 1; next }
        /^Would / { collecting = 0 } # a new directive ends the block; inline rules below decide
        collecting && (/^[[:space:]]*$/ || /^Run `brew/) { collecting = 0; next }
        collecting { if ($1 !~ /^\//) print $1; next }
        /^Would (uninstall|untap) [^:(]/ { print $3 }
        /^Would remove [^:\/(]/ { print $3 }
    '
}

if [[ $MODE == "parse-cleanup" ]]; then
    names=$(parse_cleanup_names)
    count=0
    [[ -n $names ]] && count=$(printf '%s\n' "$names" | wc -l | tr -d ' ')
    printf '%s\t%s\n' "$count" "$(printf '%s' "$names" | tr '\n' ' ' | sed 's/ $//')"
    exit 0
fi

if ! command -v chezmoi >/dev/null 2>&1; then
    emit "chezmoi-drift-check: chezmoi not installed; skipping"
    exit 0
fi

if ! mkdir -p "$CACHE_DIR"; then
    emit "chezmoi-drift-check: cannot create $CACHE_DIR" >&2
    exit 2
fi

cache_fresh() {
    [[ -f "$STATE_FILE" ]] || return 1
    local now mtime
    now=$(date +%s)
    # GNU stat first, BSD stat second — the order is load-bearing. dot_zshrc
    # puts Homebrew's coreutils gnubin ahead of /usr/bin on PATH, so `stat`
    # here is usually GNU stat, whose `-f` means "filesystem status": it prints
    # a block of filesystem info to *stdout* and exits 1, so the fallback then
    # appended the real mtime to that garbage. The result never matched
    # ^[0-9]+$, mtime fell back to 0, and the cache was never fresh — this
    # whole fast path was dead code. BSD stat rejects `-c` cleanly (usage to
    # stderr, nothing on stdout), so this order is safe on both.
    # dot_zshrc:159-161 works around the same GNU/BSD `-f` clash.
    mtime=$(stat -c %Y "$STATE_FILE" 2>/dev/null || stat -f %m "$STATE_FILE" 2>/dev/null)
    # Force mtime to a non-negative integer. Without this, any stat oddity
    # (empty output, locale-decorated text, partial read during atomic rotate)
    # leaks into the arithmetic context below where bash's name-resolution can
    # then trigger a confusing `unbound variable` error under `set -u`.
    [[ $mtime =~ ^[0-9]+$ ]] || mtime=0
    ((now - mtime < TTL))
}

# Brief mode: fast path, return cached state if fresh.
# Defaults shield us from a partially-written or schema-drifted state file.
if [[ $MODE == "brief" ]] && cache_fresh; then
    HOME_DRIFT=
    BREW_MISSING=
    BREW_EXTRA=
    DEFAULTS_DRIFT=0
    SECURITY_DRIFT=0
    BREWUP_FAILED=0
    HAD_ERROR=0
    summary=
    # Left empty rather than 0 so that "absent from an older cache" is
    # distinguishable from "present and genuinely zero" below.
    drift_total=
    # shellcheck disable=SC1090
    . "$STATE_FILE" 2>/dev/null || true
    # The brewup marker is a single file test, so re-check it live rather than
    # trusting a cache entry that can be up to $TTL (4h) old. brewup runs from
    # shell startup and can flip this at any point inside that window; a signal
    # this cheap should never be reported stale. On disagreement, fall through
    # to the full check so the rewritten state file stays self-consistent with
    # the summary string emitted alongside it.
    _brewup_live=0
    [[ -f $BREWUP_FAIL_MARKER ]] && _brewup_live=1
    # Validate every required field parsed as a non-negative integer.
    # If any is missing/non-numeric, the cache file is partial or schema-drifted —
    # fall through to the full check rather than silently report stale counts.
    # DEFAULTS_DRIFT / SECURITY_DRIFT are forward-compatible: if absent in an
    # older cache file, they default to 0.
    if [[ $HOME_DRIFT =~ ^[0-9]+$ &&
        $BREW_MISSING =~ ^[0-9]+$ &&
        $BREW_EXTRA =~ ^[0-9]+$ &&
        ${DEFAULTS_DRIFT:-0} =~ ^[0-9]+$ &&
        ${SECURITY_DRIFT:-0} =~ ^[0-9]+$ &&
        ${BREWUP_FAILED:-0} == "$_brewup_live" &&
        -n $summary ]]; then
        emit "$summary"
        [[ ${HAD_ERROR:-0} -gt 0 ]] && exit 2
        # drift_total is composed by the full check alongside the counts it
        # sums, so it is trusted here rather than re-derived — re-deriving it
        # would keep a hand-written sum alive at the one site this change
        # exists to remove. A cache written before this field existed has no
        # drift_total, so fall back to summing the counts it does carry. The
        # counts-to-total invariant is asserted in tests/drift-check.bats.
        if [[ $drift_total =~ ^[0-9]+$ ]]; then
            [[ $drift_total -gt 0 ]] && exit 1
        else
            [[ $((HOME_DRIFT + BREW_MISSING + BREW_EXTRA + ${DEFAULTS_DRIFT:-0} + ${SECURITY_DRIFT:-0})) -gt 0 ]] && exit 1
        fi
        exit 0
    fi
    # Cache invalid; fall through to full check.
fi

# --- Full check ---
HOME_DRIFT=0
BREW_MISSING=0
BREW_EXTRA=0
BREW_EXTRA_NAMES=""
DEFAULTS_DRIFT=0
SECURITY_DRIFT=0
HAD_ERROR=0
err_parts=""

# Home drift via `chezmoi status`. Capture failure explicitly — without this,
# any chezmoi error (config syntax, missing age key, deprecated flag) silently
# yields HOME_DRIFT=0, which is the textbook silent-failure pattern this whole
# feature is meant to prevent.
if status_out=$(chezmoi status --exclude=externals 2>&1); then
    # Count only lines matching chezmoi status's `XY filename` format
    # (X,Y ∈ space|A|D|M|R). Without this guard, stderr lines captured by
    # 2>&1 — e.g. "chezmoi: warning: config file template has changed" —
    # would each count as a drifted file, falsely inflating HOME_DRIFT.
    HOME_DRIFT=$(printf '%s\n' "$status_out" | grep -cE '^[ ADMR][ ADMR] ' || true)
    HOME_DRIFT=${HOME_DRIFT:-0}
else
    HAD_ERROR=1
    err_parts="${err_parts:+$err_parts; }chezmoi status failed"
fi

if command -v brew >/dev/null 2>&1; then
    rendered=$(mktemp -t brewfile-rendered.XXXXXX)
    # shellcheck disable=SC2064
    trap "rm -f '$rendered'" EXIT INT TERM HUP
    if ! chezmoi execute-template <"$(chezmoi source-path)/Brewfile.tmpl" >"$rendered" 2>/dev/null; then
        HAD_ERROR=1
        err_parts="${err_parts:+$err_parts; }Brewfile.tmpl render failed"
    else
        # Missing: brew bundle check exits non-zero when entries are missing OR when it
        # itself errors. Distinguish by inspecting verbose output.
        verbose_out=$(brew bundle check --no-upgrade --verbose --file="$rendered" 2>&1)
        verbose_rc=$?
        BREW_MISSING=$(printf '%s\n' "$verbose_out" | grep -cE '(needs to be installed|not installed)' || true)
        if [[ $verbose_rc -ne 0 && $BREW_MISSING -eq 0 ]]; then
            HAD_ERROR=1
            err_parts="${err_parts:+$err_parts; }brew bundle check failed"
        fi
        # Extras: cleanup dry-run. Same pattern — non-zero exit with no matched lines means errored.
        cleanup_out=$(brew bundle cleanup --file="$rendered" 2>&1)
        cleanup_rc=$?
        # `Would remove: /path/...` lines are routine brew cache cleanups, not
        # unmanaged packages. parse_cleanup_names handles both the modern block
        # output (header + one name per line) and the legacy inline form —
        # counting the header lines themselves used to under-report extras.
        extra_names=$(printf '%s\n' "$cleanup_out" | parse_cleanup_names)
        if [[ -n $extra_names ]]; then
            BREW_EXTRA=$(printf '%s\n' "$extra_names" | wc -l | tr -d ' ')
            BREW_EXTRA_NAMES=$(printf '%s' "$extra_names" | tr '\n' ' ')
            BREW_EXTRA_NAMES=${BREW_EXTRA_NAMES% }
        fi
        if [[ $cleanup_rc -ne 0 && $BREW_EXTRA -eq 0 ]]; then
            HAD_ERROR=1
            err_parts="${err_parts:+$err_parts; }brew bundle cleanup failed"
        fi
    fi
fi

# macOS defaults drift — counts settings that diverged from the source script.
# The audit is best-effort; if it fails entirely, record the error but don't
# poison the other counts. Skipped silently when the audit tool isn't on PATH
# (e.g., during early bootstrap before chezmoi apply has run).
if command -v chezmoi-defaults-audit >/dev/null 2>&1; then
    # The audit exits 1 when drift is detected — that's the expected outcome,
    # not an error. Only treat empty/garbled output as a real error.
    audit_out=$(chezmoi-defaults-audit --quiet 2>/dev/null) || true
    if [[ -n $audit_out ]]; then
        DEFAULTS_DRIFT=$(printf '%s' "$audit_out" | awk -F'\t' '{print $2}')
        [[ $DEFAULTS_DRIFT =~ ^[0-9]+$ ]] || DEFAULTS_DRIFT=0
    else
        HAD_ERROR=1
        err_parts="${err_parts:+$err_parts; }defaults audit failed"
    fi
fi

# Security baseline drift — counts failing security checks.
if command -v chezmoi-security-audit >/dev/null 2>&1; then
    sec_out=$(chezmoi-security-audit --quiet 2>/dev/null) || true
    if [[ -n $sec_out ]]; then
        SECURITY_DRIFT=$(printf '%s' "$sec_out" | awk -F'\t' '{print $2}')
        [[ $SECURITY_DRIFT =~ ^[0-9]+$ ]] || SECURITY_DRIFT=0
    else
        HAD_ERROR=1
        err_parts="${err_parts:+$err_parts; }security audit failed"
    fi
fi

# Daily brewup outcome. Presence of the marker means the last run failed;
# brewup() removes it on the next success. Purely a file test — never shells
# out to brew, so this stays cheap enough for the shell-startup path.
BREWUP_FAILED=0
[[ -f $BREWUP_FAIL_MARKER ]] && BREWUP_FAILED=1

parts=""
[[ $HOME_DRIFT -gt 0 ]] && parts="${parts:+$parts, }home: $HOME_DRIFT"
[[ $BREW_MISSING -gt 0 ]] && parts="${parts:+$parts, }brew-missing: $BREW_MISSING"
[[ $BREW_EXTRA -gt 0 ]] && parts="${parts:+$parts, }brew-extra: $BREW_EXTRA"
[[ $DEFAULTS_DRIFT -gt 0 ]] && parts="${parts:+$parts, }defaults: $DEFAULTS_DRIFT"
[[ $SECURITY_DRIFT -gt 0 ]] && parts="${parts:+$parts, }security: $SECURITY_DRIFT"
[[ $BREWUP_FAILED -eq 1 ]] && parts="${parts:+$parts, }brewup: failed"

if [[ $HAD_ERROR -eq 1 ]]; then
    if [[ -n $parts ]]; then
        summary="drift: $parts · ERROR: $err_parts (counts may be incomplete)"
    else
        summary="drift: ERROR: $err_parts"
    fi
elif [[ -z $parts ]]; then
    summary="drift: clean"
else
    summary="drift: $parts"
fi

# Banner string — the drift-derived segments of the one-line shell banner, in
# the rendering dot_zshrc used to compose by hand from the raw count fields.
# Composed here so the banner and this script can never disagree about what is
# pending. Deliberately *not* the whole printed line: the `inbox N` segment is
# recounted live on every shell start (freezing it into a TTL-bounded cache
# would report a stale count exactly when a fresh `brew install` matters), and
# the "(as of 2h ago)" suffix, the colour, and the "— run 'mac'" tail are all
# read-time presentation. The shell appends those; this is the prefix.
#
# Note the separator and label style differ from $summary above: that string is
# for notifications ("home: 2, brew-extra: 5"), this one for the prompt banner
# ("home 2 · brew-extra 5"). Two renderings, one composition site.
#
# $err_parts is deliberately discarded here. The banner has always said a bare
# "check-error", and keeping this byte-identical is what makes this change a
# pure refactor. Naming the failing check is a follow-up, not part of this.
banner=""
[[ $HOME_DRIFT -gt 0 ]] && banner="${banner:+$banner · }home $HOME_DRIFT"
[[ $BREW_MISSING -gt 0 ]] && banner="${banner:+$banner · }brew-missing $BREW_MISSING"
[[ $BREW_EXTRA -gt 0 ]] && banner="${banner:+$banner · }brew-extra $BREW_EXTRA"
[[ $DEFAULTS_DRIFT -gt 0 ]] && banner="${banner:+$banner · }defaults $DEFAULTS_DRIFT"
[[ $SECURITY_DRIFT -gt 0 ]] && banner="${banner:+$banner · }security $SECURITY_DRIFT"
[[ $BREWUP_FAILED -eq 1 ]] && banner="${banner:+$banner · }brewup-failed"
[[ $HAD_ERROR -eq 1 ]] && banner="${banner:+$banner · }check-error"

# The drift total, computed once by the module that owns the drift schema.
# Every consumer (this script's exit code, the --brief fast path, chezmoi-fix's
# cached/fresh comparison) reads it rather than re-summing the count fields, so
# a sixth drift signal is added here and nowhere else. Computed before the
# write so the file carries it. BREWUP_FAILED and HAD_ERROR are excluded by
# design — they are conditions, not quantities of drift.
drift_total=$((HOME_DRIFT + BREW_MISSING + BREW_EXTRA + DEFAULTS_DRIFT + SECURITY_DRIFT))

# Atomic state-file write: tmp+mv so a concurrent reader never sees a partial file.
state_tmp="$STATE_FILE.tmp.$$"
if {
    printf 'HOME_DRIFT=%s\n' "$HOME_DRIFT"
    printf 'BREW_MISSING=%s\n' "$BREW_MISSING"
    printf 'BREW_EXTRA=%s\n' "$BREW_EXTRA"
    printf 'BREW_EXTRA_NAMES=%q\n' "$BREW_EXTRA_NAMES"
    printf 'DEFAULTS_DRIFT=%s\n' "$DEFAULTS_DRIFT"
    printf 'SECURITY_DRIFT=%s\n' "$SECURITY_DRIFT"
    printf 'BREWUP_FAILED=%s\n' "$BREWUP_FAILED"
    printf 'HAD_ERROR=%s\n' "$HAD_ERROR"
    printf 'CHECKED_AT=%s\n' "$(date +%s)"
    printf 'summary=%q\n' "$summary"
    printf 'banner=%q\n' "$banner"
    printf 'drift_total=%s\n' "$drift_total"
} >"$state_tmp"; then
    mv -f "$state_tmp" "$STATE_FILE" || rm -f "$state_tmp"
else
    rm -f "$state_tmp"
fi

emit "$summary"

should_notify=0
[[ $NOTIFY -eq 1 || $ALERT -eq 1 ]] && [[ $drift_total -gt 0 || $HAD_ERROR -eq 1 ]] && should_notify=1

if [[ $should_notify -eq 1 ]]; then
    # Escape backslashes and double-quotes for AppleScript string interpolation.
    notify_body=${summary//\\/\\\\}
    notify_body=${notify_body//\"/\\\"}

    if [[ $ALERT -eq 1 ]]; then
        # Clickable dialog with a "Fix now" button. Auto-dismisses after 90 seconds.
        # The result includes "button returned:Fix now" when chosen; we launch iTerm
        # and run chezmoi-fix in a fresh window. AppleScript escaping is the same
        # as for display notification.
        result=$(
            osascript <<APPLESCRIPT 2>/dev/null
try
    tell application "System Events"
        set theResp to display dialog "$notify_body" with title "chezmoi drift" buttons {"Dismiss", "Fix now"} default button "Fix now" giving up after 90 with icon caution
    end tell
    return button returned of theResp
on error
    return ""
end try
APPLESCRIPT
        )
        if [[ $result == "Fix now" ]]; then
            # Open iTerm and run chezmoi-fix in a new window. Fall back to opening
            # Terminal.app if iTerm isn't installed.
            if osascript -e 'tell application "iTerm" to activate' >/dev/null 2>&1; then
                osascript <<'APPLESCRIPT' >/dev/null 2>&1 || true
tell application "iTerm"
    activate
    set newWindow to (create window with default profile)
    tell current session of newWindow to write text "chezmoi-fix"
end tell
APPLESCRIPT
            else
                osascript <<'APPLESCRIPT' >/dev/null 2>&1 || true
tell application "Terminal"
    activate
    do script "chezmoi-fix"
end tell
APPLESCRIPT
            fi
        fi
    else
        # Non-interactive notification (existing behaviour).
        osascript -e "display notification \"$notify_body\" with title \"chezmoi drift\"" >/dev/null 2>&1 || true
    fi
fi

if [[ $HAD_ERROR -eq 1 ]]; then
    exit 2
fi
[[ $drift_total -gt 0 ]] && exit 1
exit 0
