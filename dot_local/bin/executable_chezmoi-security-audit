#!/usr/bin/env bash
# chezmoi-security-audit — read-only check of the machine's security baseline.
#
# Verifies the protections the sudo bootstrap script (macos-sudo.sh) tries to
# establish (FileVault, SIP, firewall, guest account off), plus a few ongoing
# hygiene checks (key permissions, GPG expiry, pending macOS updates). Counts
# feed into chezmoi-drift-check as SECURITY_DRIFT. The pmset and auto-update
# expectations are read out of the bootstrap script at run time, never copied.
#
# Modes:
#   (default)  Human report.
#   --drift    Print each failing check explicitly.
#   --quiet    TSV: "<ok>\t<failed>\t<skipped>".
#              The audit protocol chezmoi-drift-check consumes — see
#              docs/runbooks/recover-from-drift.md, "Audit protocol".
#
# Exit: 0 clean, 1 drift, 2 audit error.

set -uo pipefail

DRIFT=0
QUIET=0

usage() {
    cat <<'EOF'
chezmoi-security-audit [--drift] [--quiet] [-h]

Checks: FileVault, SIP, Gatekeeper, firewall+stealth, guest account, auto-login,
remote Apple Events, SSH remote login, NordVPN Shield extension off,
LaunchAgents and LaunchDaemons pointing at a missing program, SSH key passphrase, AWS creds perms, age key perms, GPG signing key expiry (if configured),
auto-update toggles and energy settings (pmset) — both read out of the sudo
bootstrap script at run time, skipped if it cannot be sourced —
softwareupdate pending.

Exit codes: 0 clean, 1 drift, 2 audit error.
EOF
}

for arg in "$@"; do
    case "$arg" in
        --drift) DRIFT=1 ;;
        --quiet) QUIET=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "chezmoi-security-audit: unknown arg: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

OK=0
FAIL=0
SKIP=0
FAILED=()

check() {
    local name=$1 status=$2 detail=${3:-}
    case "$status" in
        ok) OK=$((OK + 1)) ;;
        fail)
            FAIL=$((FAIL + 1))
            FAILED+=("$name — $detail")
            ;;
        skip) SKIP=$((SKIP + 1)) ;;
    esac
}

# ------------------------------------------------------------------------------
# FileVault
# ------------------------------------------------------------------------------
if command -v fdesetup >/dev/null 2>&1; then
    fv_status=$(fdesetup status 2>/dev/null | head -1)
    case "$fv_status" in
        *"FileVault is On"*) check "FileVault" ok ;;
        *"FileVault is Off"*) check "FileVault" fail "disk encryption disabled — enable via System Settings ➜ Privacy & Security ➜ FileVault" ;;
        *) check "FileVault" skip ;;
    esac
else
    check "FileVault" skip
fi

# ------------------------------------------------------------------------------
# System Integrity Protection
# ------------------------------------------------------------------------------
if command -v csrutil >/dev/null 2>&1; then
    sip_status=$(csrutil status 2>/dev/null)
    if printf '%s' "$sip_status" | grep -qi 'enabled'; then
        check "System Integrity Protection" ok
    else
        check "System Integrity Protection" fail "SIP disabled — boot into recovery and run \`csrutil enable\`"
    fi
else
    check "System Integrity Protection" skip
fi

# ------------------------------------------------------------------------------
# Gatekeeper — assesses downloaded/unsigned apps before first launch. On by
# default and not enforced by this repo, so confirm it hasn't been disabled
# (parity with the SIP check above; spctl isn't script-set here either).
# ------------------------------------------------------------------------------
if command -v spctl >/dev/null 2>&1; then
    if spctl --status 2>/dev/null | grep -qi 'assessments enabled'; then
        check "Gatekeeper" ok
    else
        check "Gatekeeper" fail "Gatekeeper disabled — \`sudo spctl --master-enable\`"
    fi
else
    check "Gatekeeper" skip
fi

# ------------------------------------------------------------------------------
# Application firewall (run_once_after_05-macos-sudo.sh sets this on bootstrap).
# The com.apple.alf plist may be absent on newer macOS; query the daemon directly.
# ------------------------------------------------------------------------------
FW_BIN=/usr/libexec/ApplicationFirewall/socketfilterfw
if [[ -x $FW_BIN ]]; then
    fw_global=$("$FW_BIN" --getglobalstate 2>/dev/null)
    if printf '%s' "$fw_global" | grep -qiE 'enabled|State = 1|State = 2'; then
        check "Firewall enabled" ok
    else
        check "Firewall enabled" fail "${fw_global:-unknown} — \`sudo $FW_BIN --setglobalstate on\`"
    fi
    fw_stealth=$("$FW_BIN" --getstealthmode 2>/dev/null)
    if printf '%s' "$fw_stealth" | grep -qi 'on'; then
        check "Firewall stealth mode" ok
    else
        check "Firewall stealth mode" fail "${fw_stealth:-unknown} — \`sudo $FW_BIN --setstealthmode on\`"
    fi
else
    check "Firewall enabled" skip
    check "Firewall stealth mode" skip
fi

# ------------------------------------------------------------------------------
# Guest account — run_once_after_05-macos-sudo.sh disables it on bootstrap, but
# that wrapper only fires once, so re-check here on every drift run. The
# loginwindow plist is world-readable, so no sudo is needed to read the state.
# ------------------------------------------------------------------------------
guest_enabled=$(defaults read /Library/Preferences/com.apple.loginwindow GuestEnabled 2>/dev/null)
case "$guest_enabled" in
    0) check "Guest account disabled" ok ;;
    1) check "Guest account disabled" fail "guest login enabled — \`sudo defaults write /Library/Preferences/com.apple.loginwindow GuestEnabled -bool false\` (or re-run ~/.config/chezmoi/scripts/macos-sudo.sh)" ;;
    *) check "Guest account disabled" skip ;;
esac

# ------------------------------------------------------------------------------
# Automatic login — must stay OFF so an unattended boot can't reach the desktop
# without the account password (this also underpins FileVault's at-rest value).
# loginwindow is world-readable; an absent autoLoginUser key => auto-login off.
# ------------------------------------------------------------------------------
autologin_user=$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)
if [[ -z $autologin_user ]]; then
    check "Auto-login disabled" ok
else
    check "Auto-login disabled" fail "auto-login on for '$autologin_user' — \`sudo defaults delete /Library/Preferences/com.apple.loginwindow autoLoginUser && sudo rm -f /etc/kcpassword\` (or re-run ~/.config/chezmoi/scripts/macos-sudo.sh)"
fi

# ------------------------------------------------------------------------------
# Remote Apple Events — a legacy remote-AppleScript service that should stay off
# (macOS default). There is no unprivileged read of systemsetup's flag, so
# introspect the launchd daemon it toggles (com.apple.AEServer): disabled => off
# (good), enabled => on (bad). Unknown/unreadable => skip, never a false fail.
# ------------------------------------------------------------------------------
rae=$(launchctl print-disabled system 2>/dev/null | grep -i 'com.apple.AEServer')
if printf '%s' "$rae" | grep -qiE 'AEServer" => (true|disabled)'; then
    check "Remote Apple Events off" ok
elif printf '%s' "$rae" | grep -qiE 'AEServer" => (false|enabled)'; then
    check "Remote Apple Events off" fail "remote AppleScript enabled — \`sudo systemsetup -setremoteappleevents off\` (needs Full Disk Access) or disable via System Settings ➜ General ➜ Sharing"
else
    check "Remote Apple Events off" skip
fi

# ------------------------------------------------------------------------------
# SSH remote login (sshd) — should stay OFF (macOS default). systemsetup
# -getremotelogin needs Full Disk Access, so introspect the launchd daemon it
# toggles (com.openssh.sshd) exactly like Remote Apple Events above: disabled =>
# off (good), enabled => on (bad); unknown/unreadable => skip, never a false fail.
# ------------------------------------------------------------------------------
sshd_state=$(launchctl print-disabled system 2>/dev/null | grep -i 'com.openssh.sshd')
if printf '%s' "$sshd_state" | grep -qiE 'sshd" => (true|disabled)'; then
    check "SSH remote login off" ok
elif printf '%s' "$sshd_state" | grep -qiE 'sshd" => (false|enabled)'; then
    check "SSH remote login off" fail "SSH remote login enabled — \`sudo systemsetup -f -setremotelogin off\` or System Settings ➜ General ➜ Sharing ➜ Remote Login"
else
    check "SSH remote login off" skip
fi

# ------------------------------------------------------------------------------
# NordVPN's Shield extension caused the Oct–Nov 2026 Wi-Fi latency spells
# (docs/troubleshooting.md). Its only switch is in System Settings, so a reinstall
# could bring it back unnoticed. Disabled, terminating or absent all pass, and any
# other state fails, so a new macOS state label gets looked at. An empty listing
# means the tool gave no answer, so skip rather than report a false pass.
# ------------------------------------------------------------------------------
check_nordvpn_shield() {
    local listing bad state
    listing=$(systemextensionsctl list 2>/dev/null)
    if [[ -z $listing ]]; then
        check "NordVPN Shield off" skip
        return
    fi
    bad=$(printf '%s\n' "$listing" | grep -F 'com.nordvpn.macos.Shield' | grep -vE '\[(activated disabled|terminated[^]]*)\]')
    if [[ -z $bad ]]; then
        check "NordVPN Shield off" ok
    else
        state=$(printf '%s\n' "$bad" | grep -oE '\[[^]]*\]' | head -1)
        check "NordVPN Shield off" fail "extension is ${state:-in an unrecognised state} — switch off NordVPN protection in System Settings ➜ General ➜ Login Items & Extensions ➜ Endpoint Security Extensions, then restart"
    fi
}
check_nordvpn_shield

# ------------------------------------------------------------------------------
# Launch items whose program is gone. launchd still loads the plist at every
# login or boot, so whatever later appears at that path runs unprompted.
# Nothing else reports these: uninstalling the software leaves the plist behind
# and chezmoi does not manage it.
#
# Per-user agents are usually `brew services` leftovers pointing under
# /opt/homebrew, which is user-writable. The system-wide directories matter
# more: a LaunchDaemon runs as root, and the usual leftover there points into
# /Applications, which any admin account can write to without a password.
#
# Only absolute paths are judged; launchd resolves a bare name through its own
# PATH. No plist yielding a judgeable path means the read told us nothing, so
# skip rather than report a false pass.
# ------------------------------------------------------------------------------

# check_launch_items <check name> <directory> <fix, applied per orphan>
check_launch_items() {
    local name=$1 dir=$2 fix=$3
    local plist prog label judged=0 orphaned=0 orphans=""
    if [[ ! -d $dir ]] || ! command -v plutil >/dev/null 2>&1; then
        check "$name" skip
        return
    fi
    for plist in "$dir"/*.plist; do
        [[ -f $plist ]] || continue
        prog=$(plutil -extract Program raw -o - "$plist" 2>/dev/null) \
            || prog=$(plutil -extract ProgramArguments.0 raw -o - "$plist" 2>/dev/null) \
            || continue
        [[ $prog == /* ]] || continue
        judged=$((judged + 1))
        [[ -e $prog ]] && continue
        label=${plist##*/}
        orphaned=$((orphaned + 1))
        orphans="${orphans:+$orphans, }${label%.plist}"
    done
    if ((judged == 0)); then
        check "$name" skip
    elif ((orphaned == 0)); then
        check "$name" ok
    else
        check "$name" fail "$orphaned of $judged point at a missing program: $orphans — for each, $fix"
    fi
}

# check_all_launch_items [root] — root relocates the two system directories so
# the tests can stand in for /Library; the per-user one follows $HOME.
check_all_launch_items() {
    local root=${1:-}
    check_launch_items "LaunchAgent programs exist" "$HOME/Library/LaunchAgents" \
        "\`launchctl bootout gui/\$(id -u) ~/Library/LaunchAgents/<name>.plist\` then delete that plist"
    check_launch_items "System LaunchAgent programs exist" "$root/Library/LaunchAgents" \
        "\`launchctl bootout gui/\$(id -u) /Library/LaunchAgents/<name>.plist\` then \`sudo rm\` that plist"
    check_launch_items "LaunchDaemon programs exist" "$root/Library/LaunchDaemons" \
        "\`sudo launchctl bootout system /Library/LaunchDaemons/<name>.plist\` then \`sudo rm\` that plist"
}
check_all_launch_items

# ------------------------------------------------------------------------------
# SSH private keys — verify each one is passphrase-protected.
# ssh-keygen -y -P "" succeeds when the key has NO passphrase (bad).
# Non-zero exit means the key required a passphrase (good).
# ------------------------------------------------------------------------------
ssh_dir="$HOME/.ssh"
ssh_keys_seen=0
ssh_keys_unprotected=0
if [[ -d $ssh_dir ]]; then
    shopt -s nullglob
    for kf in "$ssh_dir"/id_* "$ssh_dir"/*_id_* "$ssh_dir"/*.pem; do
        [[ -f $kf && ! $kf == *.pub ]] || continue
        # Skip files that don't look like private keys.
        if head -1 "$kf" 2>/dev/null | grep -qE 'BEGIN.*PRIVATE KEY'; then
            ssh_keys_seen=$((ssh_keys_seen + 1))
            if ssh-keygen -y -P "" -f "$kf" >/dev/null 2>&1; then
                ssh_keys_unprotected=$((ssh_keys_unprotected + 1))
            fi
        fi
    done
    shopt -u nullglob
fi
if ((ssh_keys_seen == 0)); then
    check "SSH key passphrase" skip
elif ((ssh_keys_unprotected == 0)); then
    check "SSH key passphrase" ok
else
    check "SSH key passphrase" fail "${ssh_keys_unprotected} of ${ssh_keys_seen} keys lack a passphrase — re-encrypt with \`ssh-keygen -p -f <key>\`"
fi

# ------------------------------------------------------------------------------
# Sensitive file permissions
# ------------------------------------------------------------------------------
check_perm() {
    local name=$1 path=$2 expected=$3
    if [[ ! -e $path ]]; then
        check "$name" skip
        return
    fi
    # Force BSD stat: this repo deploys GNU coreutils first on PATH, so a bare
    # `stat -f '%Lp'` gets routed to GNU stat (which then prints filesystem info).
    local actual
    actual=$(/usr/bin/stat -f '%Lp' "$path" 2>/dev/null)
    if [[ $actual == "$expected" ]]; then
        check "$name" ok
    else
        check "$name" fail "$path is ${actual:-?}, expected $expected — \`chmod $expected $path\`"
    fi
}

check_perm "Age key perms" "$HOME/.config/chezmoi/key.txt" 600
check_perm "AWS credentials perms" "$HOME/.aws/credentials" 600
check_perm "AWS config perms" "$HOME/.aws/config" 600
check_perm "SSH config perms" "$HOME/.ssh/config" 600

# ------------------------------------------------------------------------------
# GPG signing key expiry, if configured.
# ------------------------------------------------------------------------------
gpg_key=$(chezmoi data 2>/dev/null | awk -F'"' '/"gpg_signing_key"/ {print $4}')
if [[ -n $gpg_key ]] && command -v gpg >/dev/null 2>&1; then
    # Parse machine-readable output. Each pub/sub line carries an expiry timestamp in field 7.
    expiry=$(gpg --list-keys --with-colons "$gpg_key" 2>/dev/null | awk -F: '$1=="pub"{print $7; exit}')
    if [[ -z $expiry || $expiry == 0 ]]; then
        check "GPG signing key expiry" ok # no expiry set
    else
        now=$(date +%s)
        days_left=$(((expiry - now) / 86400))
        if ((days_left < 0)); then
            check "GPG signing key expiry" fail "key $gpg_key expired $((-days_left)) day(s) ago"
        elif ((days_left < 30)); then
            check "GPG signing key expiry" fail "key $gpg_key expires in $days_left day(s) — rotate or extend soon"
        else
            check "GPG signing key expiry" ok
        fi
    fi
else
    check "GPG signing key expiry" skip
fi

# ------------------------------------------------------------------------------
# Bootstrap-derived expectations. The pmset values and SoftwareUpdate toggles
# this audit checks are whatever the sudo bootstrap script asserts — read out
# of the script, not copied into this one. Same technique as
# chezmoi-defaults-audit's parse_expectations: source the script in a subshell
# with every command it runs replaced by a shell function, so the argv of the
# calls we care about is captured fully expanded and nothing executes.
#
# History: these were hand-copied constants until Sep 2026. pmset drift is real
# and silent — AC sleep was found drifted to 1 in Aug 2026 with nothing
# flagging it, after the machine spent four days awake on the charger — and a
# copy can only ever be as current as the last person who remembered to
# update it.
#
# The bootstrap logic lives in the deployed script, not in the run_once
# wrapper that execs it.
# ------------------------------------------------------------------------------
BOOTSTRAP_REL=dot_config/chezmoi/scripts/executable_macos-sudo.sh

bootstrap_script_path() {
    local src
    command -v chezmoi >/dev/null 2>&1 || return 1
    src=$(chezmoi source-path 2>/dev/null) || return 1
    [[ -f $src/$BOOTSTRAP_REL ]] || return 1
    printf '%s\n' "$src/$BOOTSTRAP_REL"
}

# parse_bootstrap_expectations <script> — one TSV row per captured assertion,
# last write wins per (kind, scope, key):
#   pmset     <Battery|AC>  <key>  <value>
#   swupdate  defaults      <key>  <0|1>     (defaults write … SoftwareUpdate)
#   swupdate  schedule      check  <on|off>  (softwareupdate --schedule)
# Non-zero exit means the script could not be sourced to completion.
#
# Safety: the script's own `set -euo pipefail` takes effect once sourced, so
# every stub returns 0 — a non-zero stub would abort the source part-way and
# hand back a silently truncated list. `sudo -v` in particular must succeed:
# the script exits 0 (cleanly, no expectations) when it fails. Stubs use
# `builtin printf` because `printf` and `echo` are themselves stubbed.
parse_bootstrap_expectations() {
    local script=$1
    (
        set +euo pipefail
        # Everything below is invoked indirectly via `source`; the SC2329
        # disables silence the "never invoked" note.
        # shellcheck disable=SC2329
        sudo() {
            case "${1:-}" in
                -v | -n | -k | -K) return 0 ;;
                pmset | defaults | softwareupdate) "$@" ;;
                *) return 0 ;;
            esac
        }
        # shellcheck disable=SC2329
        pmset() {
            local scopes=() key value scope
            case "${1:-}" in
                -a) scopes=(Battery AC) ;;
                -b) scopes=(Battery) ;;
                -c) scopes=(AC) ;;
                *) return 0 ;;
            esac
            shift
            while (($# >= 2)); do
                key=$1 value=$2
                shift 2
                for scope in "${scopes[@]}"; do
                    builtin printf 'pmset\t%s\t%s\t%s\n' "$scope" "$key" "$value"
                done
            done
            return 0
        }
        # shellcheck disable=SC2329
        defaults() {
            [[ ${1:-} == write && ${2:-} == */com.apple.SoftwareUpdate ]] || return 0
            local key=${3:-} value=${5:-}
            [[ ${4:-} == -bool ]] || return 0
            case "$(builtin printf '%s' "$value" | tr '[:upper:]' '[:lower:]')" in
                true | yes | 1) value=1 ;;
                false | no | 0) value=0 ;;
                *) return 0 ;;
            esac
            builtin printf 'swupdate\tdefaults\t%s\t%s\n' "$key" "$value"
        }
        # shellcheck disable=SC2329
        softwareupdate() {
            [[ ${1:-} == --schedule && -n ${2:-} ]] || return 0
            builtin printf 'swupdate\tschedule\tcheck\t%s\n' "$2"
        }
        # Every other command the script runs, read-only or not: no-op. Listed
        # rather than discovered so a new side-effecting command added to the
        # bootstrap script is a visible edit here, not a silent execution.
        local stub
        for stub in echo printf cat tee cp mv rm rmdir mkdir chmod chown sed \
            launchctl killall fdesetup systemsetup dscl spctl csrutil \
            open osascript touch sleep; do
            eval "$stub() { return 0; }"
        done
        # shellcheck disable=SC1090
        source "$script" 2>/dev/null
    ) 2>/dev/null | awk -F'\t' '
        { k = $1 FS $2 FS $3; if (!(k in row)) order[++n] = k; row[k] = $0 }
        END { for (i = 1; i <= n; i++) print row[order[i]] }'
    return "${PIPESTATUS[0]}"
}

# missing (no chezmoi / no script) and unsourceable both degrade the two
# derived checks to skip — consistent with every other unreadable signal here.
bootstrap_expectations=
bootstrap_state=missing
load_bootstrap_expectations() {
    local script
    bootstrap_expectations=
    bootstrap_state=missing
    if script=$(bootstrap_script_path); then
        if bootstrap_expectations=$(parse_bootstrap_expectations "$script"); then
            bootstrap_state=ok
        else
            bootstrap_state=unsourceable
        fi
    fi
}

# expectations <kind> — the rows of one kind, or nothing.
expectations() {
    [[ $bootstrap_state == ok ]] || return 0
    printf '%s\n' "$bootstrap_expectations" | awk -F'\t' -v kind="$1" '$1 == kind'
}

# ------------------------------------------------------------------------------
# Automatic-update toggles — the switches the bootstrap script sets. Distinct
# from the pending-updates check below (which counts what's waiting): this
# confirms the machine is still configured to fetch & install updates,
# including ConfigDataInstall (XProtect / security-definition data). The
# /Library/Preferences plist is world-readable, so no sudo is needed.
#
# The schedule toggle is intentionally NOT read from a defaults key: macOS 26
# (Tahoe) no longer persists AutomaticCheckEnabled — the key vanishes even
# while auto-check is on, giving a false negative. `softwareupdate --schedule`
# is the authoritative, version-stable signal, which is also why the bootstrap
# script sets it that way.
# ------------------------------------------------------------------------------
check_auto_updates() {
    local su_domain=/Library/Preferences/com.apple.SoftwareUpdate
    local su_rows su_scope su_key su_want au_off=()
    su_rows=$(expectations swupdate)
    if [[ -z $su_rows ]]; then
        check "Auto-update toggles" skip
        return
    fi
    while IFS=$'\t' read -r _ su_scope su_key su_want; do
        [[ -n $su_key ]] || continue
        if [[ $su_scope == schedule ]]; then
            softwareupdate --schedule 2>/dev/null | grep -qi "turned $su_want" || au_off+=("automatic-check")
        else
            [[ $(defaults read "$su_domain" "$su_key" 2>/dev/null) == "$su_want" ]] || au_off+=("$su_key")
        fi
    done <<<"$su_rows"
    if ((${#au_off[@]} == 0)); then
        check "Auto-update toggles" ok
    else
        check "Auto-update toggles" fail "disabled: ${au_off[*]} — re-run ~/.config/chezmoi/scripts/macos-sudo.sh"
    fi
}

# ------------------------------------------------------------------------------
# Energy settings — the pmset values the bootstrap script sets.
# `pmset -g custom` needs no sudo.
# ------------------------------------------------------------------------------
check_energy_settings() {
    local pm_rows pm_custom pm_src pm_key pm_want pm_live pm_bad=()
    pm_rows=$(expectations pmset)
    pm_custom=$(pmset -g custom 2>/dev/null)
    if [[ -z $pm_rows || -z $pm_custom ]]; then
        check "Energy settings (pmset)" skip
        return
    fi
    while IFS=$'\t' read -r _ pm_src pm_key pm_want; do
        [[ -n $pm_key ]] || continue
        pm_live=$(printf '%s\n' "$pm_custom" | awk -v src="$pm_src" -v key="$pm_key" '
            /^Battery Power:/ { sec = "Battery" }
            /^AC Power:/ { sec = "AC" }
            sec == src && $1 == key { print $2; exit }')
        [[ $pm_live == "$pm_want" ]] || pm_bad+=("$pm_src $pm_key=${pm_live:-unset} (want $pm_want)")
    done <<<"$pm_rows"
    if ((${#pm_bad[@]} == 0)); then
        check "Energy settings (pmset)" ok
    else
        check "Energy settings (pmset)" fail "${pm_bad[*]} — re-run ~/.config/chezmoi/scripts/macos-sudo.sh"
    fi
}

load_bootstrap_expectations
check_auto_updates
check_energy_settings

# ------------------------------------------------------------------------------
# Pending macOS software updates. Cached 24h because softwareupdate -l is a
# network call (Apple's update server) and slow.
# ------------------------------------------------------------------------------
SU_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-security"
SU_CACHE="$SU_CACHE_DIR/softwareupdate.txt"
SU_TTL=86400
mkdir -p "$SU_CACHE_DIR" 2>/dev/null || true
need_refresh=1
if [[ -f $SU_CACHE ]]; then
    mtime=$(stat -f %m "$SU_CACHE" 2>/dev/null)
    [[ $mtime =~ ^[0-9]+$ ]] || mtime=0
    (($(date +%s) - mtime < SU_TTL)) && need_refresh=0
fi
if ((need_refresh)) && command -v softwareupdate >/dev/null 2>&1; then
    if softwareupdate -l >"$SU_CACHE.tmp.$$" 2>&1; then
        mv -f "$SU_CACHE.tmp.$$" "$SU_CACHE"
    else
        rm -f "$SU_CACHE.tmp.$$"
    fi
fi
if [[ -f $SU_CACHE ]]; then
    if grep -qiE 'no new software available|no software available|no updates' "$SU_CACHE" 2>/dev/null; then
        check "macOS software updates" ok
    elif grep -qE 'Label|Title' "$SU_CACHE" 2>/dev/null; then
        # No `|| echo 0` fallback: grep -c always prints a count (0 included)
        # before its non-zero no-match exit, so the fallback *appended* a second
        # line and produced the literal "0\n0" as the pending count.
        pending=$(grep -cE '^\* Label:|^   Title:' "$SU_CACHE" 2>/dev/null) || true
        # The outer gate (bare 'Label'/'Title' anywhere) is looser than the
        # anchored count patterns above, so it can match while the count comes
        # back 0 — most plausibly because `softwareupdate`'s output format
        # drifted from what the anchors expect. Three bad options and one
        # right one: `ok` would assert "verified clean" on data we couldn't
        # parse; `skip` is honest but silent (check() carries a detail string
        # only for `fail`, so a skip is an anonymous counter bump the user
        # never sees); and the old `fail` said "0 update(s) pending", which is
        # nonsense. Fail loudly with an accurate reason instead — a parser
        # that has stopped recognising pending updates is itself the security
        # problem, and failing open is what made the bash-3.2 `normalize_bool`
        # bug (docs/gotchas.md, "env bash is bash 3.2 during the bootstrap
        # window") so hard to notice.
        if ((pending > 0)); then
            check "macOS software updates" fail "$pending update(s) pending — \`softwareupdate -l\` to inspect, then install via System Settings"
        else
            check "macOS software updates" fail "cannot parse the softwareupdate cache — its format may have changed, so pending updates would go undetected. Run \`softwareupdate -l\` manually, then check the '^* Label:'/'^   Title:' patterns in this script"
        fi
    else
        check "macOS software updates" skip
    fi
else
    check "macOS software updates" skip
fi

# ------------------------------------------------------------------------------
# Output
# ------------------------------------------------------------------------------
if ((QUIET)); then
    printf '%d\t%d\t%d\n' "$OK" "$FAIL" "$SKIP"
else
    echo "Security baseline:"
    printf '  ok:       %d\n' "$OK"
    printf '  failed:   %d\n' "$FAIL"
    printf '  skipped:  %d\n' "$SKIP"
    if ((${#FAILED[@]} > 0 && DRIFT)); then
        echo
        echo "Failures:"
        for f in "${FAILED[@]}"; do
            printf '  - %s\n' "$f"
        done
    elif ((FAIL > 0)); then
        echo
        echo "Re-run with --drift to see specifics."
    fi
fi

((FAIL > 0)) && exit 1
exit 0
